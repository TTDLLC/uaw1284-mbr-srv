<section class="page-header">
  <h1>User Role Management</h1>
  <p>Search and update user roles.</p>
</section>

<section class="user-search">
  <form method="get" action="/portal/staff/users" class="form-card">
    <div class="form-row">
      <label for="user-search">Search by name or email</label>
      <input
        type="text"
        id="user-search"
        name="q"
        value="<%= q || '' %>"
        placeholder="e.g. jane@example.com">
    </div>
    <div class="form-actions">
      <button type="submit">Search</button>
      <% if (q) { %>
        <a href="/portal/staff/users">Reset</a>
      <% } %>
    </div>
  </form>
</section>

<section class="audit-table-section">
  <table class="audit-table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Role</th>
        <th>Details</th>
      </tr>
    </thead>
    <tbody>
      <% if (users.length === 0) { %>
        <tr>
          <td colspan="4">No users found.</td>
        </tr>
      <% } %>
      <% users.forEach((user) => { %>
        <tr>
          <td><%= user.name %></td>
          <td><%= user.email %></td>
          <td><code><%= user.role %></code></td>
          <td><a href="/portal/staff/users/<%= user.id %>">Manage</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
