<section class="page-header">
  <h1>Manage Events</h1>
  <p>Create and publish union events.</p>
</section>

<p><a href="/portal/staff/events/new">Add new event</a></p>

<section class="audit-table-section">
  <table class="audit-table">
    <thead>
      <tr>
        <th>Title</th>
        <th>Start</th>
        <th>Visibility</th>
        <th>Status</th>
        <th>Details</th>
      </tr>
    </thead>
    <tbody>
      <% if (events.length === 0) { %>
        <tr>
          <td colspan="5">No events created yet.</td>
        </tr>
      <% } %>
      <% events.forEach((event) => { %>
        <tr>
          <td><%= event.title %></td>
          <td><%= event.startAtFormatted %></td>
          <td><%= event.visibility %></td>
          <td><%= event.active ? 'Active' : 'Archived' %></td>
          <td>
            <a href="/portal/staff/events/<%= event.id %>/edit">Edit</a>
            <a href="/portal/staff/events/<%= event.id %>/attendees">Attendees</a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
