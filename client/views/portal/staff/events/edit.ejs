<section class="page-header">
  <h1>Edit Event</h1>
  <p>Update event details and visibility.</p>
</section>

<form method="post" action="/portal/staff/events/<%= event._id %>" class="form-card">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="form-row">
    <label for="title">Title</label>
    <input id="title" name="title" type="text" value="<%= form.title %>">
  </div>
  <div class="form-row">
    <label for="description">Description</label>
    <input id="description" name="description" type="text" value="<%= form.description || '' %>">
  </div>
  <div class="form-row">
    <label for="location">Location</label>
    <input id="location" name="location" type="text" value="<%= form.location || '' %>">
  </div>
  <div class="form-row">
    <label for="startAt">Start</label>
    <input id="startAt" name="startAt" type="datetime-local" value="<%= form.startAt %>">
  </div>
  <div class="form-row">
    <label for="endAt">End</label>
    <input id="endAt" name="endAt" type="datetime-local" value="<%= form.endAt %>">
  </div>
  <div class="form-row">
    <label for="timezone">Timezone</label>
    <input id="timezone" name="timezone" type="text" value="<%= form.timezone || 'America/Detroit' %>">
  </div>
  <div class="form-row">
    <label for="visibility">Visibility</label>
    <select id="visibility" name="visibility">
      <option value="all" <%= form.visibility === 'all' ? 'selected' : '' %>>All members</option>
      <option value="departments" <%= form.visibility === 'departments' ? 'selected' : '' %>>Departments</option>
      <option value="labels" <%= form.visibility === 'labels' ? 'selected' : '' %>>Labels</option>
      <option value="mixed" <%= form.visibility === 'mixed' ? 'selected' : '' %>>Departments or Labels</option>
    </select>
  </div>
  <div class="form-row">
    <label for="departmentIds">Departments</label>
    <select id="departmentIds" name="departmentIds" multiple>
      <% departments.forEach((department) => { %>
        <option value="<%= department._id %>" <%= form.departmentIds?.some((id) => String(id) === String(department._id)) ? 'selected' : '' %>>
          <%= department.name %>
        </option>
      <% }) %>
    </select>
  </div>
  <div class="form-row">
    <label for="labelIds">Labels</label>
    <select id="labelIds" name="labelIds" multiple>
      <% labels.forEach((label) => { %>
        <option value="<%= label._id %>" <%= form.labelIds?.some((id) => String(id) === String(label._id)) ? 'selected' : '' %>>
          <%= label.name %>
        </option>
      <% }) %>
    </select>
  </div>
  <div class="form-row">
    <label for="capacity">Capacity</label>
    <input id="capacity" name="capacity" type="number" min="1" value="<%= form.capacity || '' %>">
  </div>
  <div class="form-row">
    <label for="rsvpDeadlineAt">RSVP Deadline</label>
    <input id="rsvpDeadlineAt" name="rsvpDeadlineAt" type="datetime-local" value="<%= form.rsvpDeadlineAt || '' %>">
  </div>
  <div class="form-row">
    <label>
      <input type="checkbox" name="active" <%= form.active !== false ? 'checked' : '' %>>
      Active
    </label>
  </div>
  <div class="form-actions">
    <button type="submit">Save Changes</button>
    <a href="/portal/staff/events">Back to Events</a>
  </div>
  <% if (errors.length) { %>
    <p class="notice"><%= errors.join(' ') %></p>
  <% } %>
  <% if (success) { %>
    <p class="notice"><%= success %></p>
  <% } %>
</form>

<form method="post" action="/portal/staff/events/<%= event._id %>/archive" class="inline-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <button type="submit">Archive Event</button>
</form>

<p><a href="/portal/staff/events/<%= event._id %>/attendees">View Attendees</a></p>
