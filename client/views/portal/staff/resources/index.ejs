<section class="page-header">
  <h1>Manage Resources</h1>
  <p>Create and manage links or file uploads for members.</p>
</section>

<p><a href="/portal/staff/resources/new">Add new resource</a></p>

<section class="audit-table-section">
  <table class="audit-table">
    <thead>
      <tr>
        <th>Title</th>
        <th>Type</th>
        <th>Scope</th>
        <th>Status</th>
        <th>Added</th>
        <th>Details</th>
      </tr>
    </thead>
    <tbody>
      <% if (resources.length === 0) { %>
        <tr>
          <td colspan="6">No resources have been created yet.</td>
        </tr>
      <% } %>
      <% resources.forEach((resource) => { %>
        <tr>
          <td><%= resource.title %></td>
          <td><code><%= resource.type %></code></td>
          <td><%= resource.scope %></td>
          <td><%= resource.active ? 'Active' : 'Archived' %></td>
          <td><%= resource.createdAtFormatted %></td>
          <td><a href="/portal/staff/resources/<%= resource.id %>/edit">Edit</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
