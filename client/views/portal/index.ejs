<section class="page-header">
  <h1>Member Portal</h1>
  <p>Welcome to the UAW Local 1284 member portal. Sprint A placeholders are listed below.</p>
</section>

<section class="dashboard">
  <h2>Member Tools</h2>
  <ul class="module-list">
    <li>My Profile (placeholder)</li>
    <li><a href="/register/phone">Verify/Update Phone</a></li>
    <li><a href="/request-email">Request Email Access</a></li>
  </ul>
</section>

<% if (user && (user.role === 'staff' || user.role === 'admin')) { %>
  <section class="dashboard">
    <h2>Staff Tools</h2>
    <ul class="module-list">
      <li><a href="/portal/staff/members">Member Directory</a></li>
      <li><a href="/portal/staff/email-requests">Email Requests</a></li>
      <li><a href="/portal/staff/notifications/new">Send Notification</a></li>
      <li><a href="/portal/staff/notifications">Notification History</a></li>
    </ul>
  </section>
<% } %>

<% if (user && user.role === 'admin') { %>
  <section class="dashboard">
    <h2>Admin Tools</h2>
    <ul class="module-list">
      <li>Departments (placeholder)</li>
      <li>User Management (placeholder)</li>
    </ul>
  </section>
<% } %>
