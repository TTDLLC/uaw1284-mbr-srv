<section class="page-header">
  <h1>Member Portal</h1>
  <p>Welcome to the UAW Local 1284 member portal. Sprint A placeholders are listed below.</p>
</section>

<section class="dashboard">
  <h2>Member Tools</h2>
  <ul class="module-list">
    <li>My Profile (placeholder)</li>
    <li><a href="/register/phone">Verify/Update Phone</a></li>
    <li><a href="/request-email">Request Email Access</a></li>
    <li><a href="/portal/profile/change-request">Request Profile Update</a></li>
    <li><a href="/portal/announcements">Announcements</a></li>
    <% if (hasPermission && hasPermission('resources.read')) { %>
      <li><a href="/portal/resources">Resources</a></li>
    <% } %>
    <% if (hasPermission && hasPermission('events.read')) { %>
      <li><a href="/portal/events">Events</a></li>
    <% } %>
  </ul>
</section>

<% if (user && hasPermission && (
  hasPermission('members.read')
  || hasPermission('members.write')
  || hasPermission('notifications.send')
  || hasPermission('notifications.read')
  || hasPermission('labels.manage')
  || hasPermission('emailRequests.review')
  || hasPermission('changeRequests.review')
  || hasPermission('audit.read')
)) { %>
  <section class="dashboard">
    <h2>Staff Tools</h2>
    <ul class="module-list">
      <% if (hasPermission('members.read') || hasPermission('members.write')) { %>
        <li><a href="/portal/staff/members">Member Directory</a></li>
      <% } %>
      <% if (hasPermission('labels.manage')) { %>
        <li><a href="/portal/staff/labels">Labels</a></li>
      <% } %>
      <% if (hasPermission('emailRequests.review')) { %>
        <li><a href="/portal/staff/email-requests">Email Requests</a></li>
      <% } %>
      <% if (hasPermission('changeRequests.review')) { %>
        <li><a href="/portal/staff/change-requests">Change Requests</a></li>
      <% } %>
      <% if (hasPermission('notifications.send')) { %>
        <li><a href="/portal/staff/notifications/new">Send Notification</a></li>
      <% } %>
      <% if (hasPermission('notifications.read')) { %>
        <li><a href="/portal/staff/notifications">Notification History</a></li>
      <% } %>
      <% if (hasPermission('audit.read')) { %>
        <li><a href="/portal/staff/audit">Audit Log</a></li>
      <% } %>
      <% if (hasPermission('resources.manage')) { %>
        <li><a href="/portal/staff/resources">Manage Resources</a></li>
      <% } %>
      <% if (hasPermission('events.manage')) { %>
        <li><a href="/portal/staff/events">Manage Events</a></li>
      <% } %>
    </ul>
  </section>
<% } %>

<% if (user && hasPermission && (hasPermission('audit.export') || hasPermission('users.manage'))) { %>
  <section class="dashboard">
    <h2>Admin Tools</h2>
    <ul class="module-list">
      <li>Departments (placeholder)</li>
      <li>User Management (placeholder)</li>
      <% if (hasPermission('users.manage')) { %>
        <li><a href="/portal/staff/users">User Role Management</a></li>
      <% } %>
      <% if (hasPermission('audit.export')) { %>
        <li><a href="/portal/staff/audit/export.csv">Export Audit CSV</a></li>
      <% } %>
    </ul>
  </section>
<% } %>
