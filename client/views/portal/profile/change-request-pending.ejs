<section class="page-header">
  <h1>Profile Change Request</h1>
  <p>Your request is awaiting review.</p>
</section>

<section class="summary">
  <h2>Pending Changes</h2>
  <p>Submitted: <%= submittedAtFormatted %></p>
  <p>Staff will review and apply approved updates soon.</p>
  <% if (!changes || changes.length === 0) { %>
    <p>No changes captured.</p>
  <% } else { %>
    <table class="data-table">
      <thead>
        <tr>
          <th>Field</th>
          <th>Current</th>
          <th>Requested</th>
        </tr>
      </thead>
      <tbody>
        <% changes.forEach(function(change) { %>
          <tr>
            <td><%= change.label %></td>
            <td><%= change.current %></td>
            <td><%= change.requested %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</section>

<p><a href="/portal">Back to portal</a></p>
