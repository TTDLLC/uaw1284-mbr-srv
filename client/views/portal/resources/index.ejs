<section class="page-header">
  <h1>Resources</h1>
  <p>Browse documents and links shared with members.</p>
</section>

<section class="resource-filters">
  <form method="get" action="/portal/resources" class="form-card">
    <div class="form-row">
      <label for="resource-type">Type</label>
      <select id="resource-type" name="type">
        <option value="">All types</option>
        <option value="link" <%= type === 'link' ? 'selected' : '' %>>Links</option>
        <option value="file" <%= type === 'file' ? 'selected' : '' %>>Files</option>
      </select>
    </div>
    <div class="form-row">
      <label for="resource-search">Search title</label>
      <input
        type="text"
        id="resource-search"
        name="q"
        value="<%= q || '' %>"
        placeholder="e.g. Contract summary">
    </div>
    <div class="form-actions">
      <button type="submit">Apply Filters</button>
      <% if (type || q) { %>
        <a href="/portal/resources">Reset</a>
      <% } %>
    </div>
  </form>
</section>

<section class="audit-table-section">
  <table class="audit-table">
    <thead>
      <tr>
        <th>Title</th>
        <th>Type</th>
        <th>Added</th>
        <th>Details</th>
      </tr>
    </thead>
    <tbody>
      <% if (resources.length === 0) { %>
        <tr>
          <td colspan="4">No resources match your filters.</td>
        </tr>
      <% } %>
      <% resources.forEach((resource) => { %>
        <tr>
          <td><%= resource.title %></td>
          <td><code><%= resource.type %></code></td>
          <td><%= resource.createdAtFormatted %></td>
          <td><a href="/portal/resources/<%= resource.id %>">View</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
